# ── Auth ──────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=                    # 32+ char random string: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000  # Set to production URL on Render
AUTH_TRUST_HOST=true                # Required behind a proxy (Render/CloudFront)

# ── Database (Neon PostgreSQL — separate project from product) ────────────────
DATABASE_URL=                       # Neon pooled connection string
DATABASE_URL_UNPOOLED=              # Neon direct connection (for migrations)
PRODUCT_DATABASE_URL=               # Read-only connection to the product DB (active-users query)

# ── Plaid ─────────────────────────────────────────────────────────────────────
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production                # sandbox | development | production
PLAID_WEBHOOK_URL=                  # https://your-domain.com/api/financial/webhook

# ── Mercury ───────────────────────────────────────────────────────────────────
MERCURY_API_KEY=                    # Read-only Mercury API key

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=                  # sk_live_... or sk_test_...
STRIPE_PUBLISHABLE_KEY=             # pk_live_...
STRIPE_WEBHOOK_SECRET=              # whsec_... for webhook verification

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=                       # PAT with repo:read (+ actions read for CI poll; repo for draft PR)
GITHUB_ORG=wmorrison76              # GitHub username/org
# Webhook HMAC secret for POST /api/webhooks/github (workflow_run / check_suite / pull_request)
GITHUB_WEBHOOK_SECRET=

# ── Render ────────────────────────────────────────────────────────────────────
RENDER_API_KEY=                     # Render personal API key (Fleet Nexus lists ALL account services)
RENDER_SERVICE_ID=                  # Primary service ID (Dr. OS deploy panel + Fleet deployment scope)

# ── Railway (optional scaffold — NOT live like Render; prefer retirement) ─────
# RAILWAY_TOKEN=                    # Account token for future GraphQL poll (TODO)
# RAILWAY_PROJECT_ID=               # Project id when poll is wired
# RAILWAY_WEBHOOK_SECRET=           # Bearer / X-Railway-Signature for POST /api/webhooks/railway

# ── Cron ──────────────────────────────────────────────────────────────────────
CRON_SECRET=                        # Bearer token guarding /api/financial/sync, /api/ops/poll-failures, …

# ── Ingest rate budgets (optional — defaults in src/lib/rate-limit.ts) ────────
# RATE_ERROR_PER_CLIENT=30
# RATE_ERROR_GLOBAL=400
# RATE_KNOWLEDGE_PER_CLIENT=60
# RATE_KNOWLEDGE_GLOBAL=200

# ── AWS (AurionIndex CDK only — not used by Next.js app) ─────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ── Board Room — Knights of the Round Table (board-room-spec.md) ─────────────
# Each seat activates only when its key is present; absent keys → "Unavailable".
PERPLEXITY_API_KEY=                 # Maestro (conductor)
OPENAI_API_KEY=                     # The Analyst (GPT)
ANTHROPIC_API_KEY=                  # The Strategist + The Architect (Claude)
# Scout (Gemini) — any one of these names works (first match wins):
GOOGLE_AI_API_KEY=                  # preferred
# GEMINI_API_KEY=                   # alias accepted
# GOOGLE_GENERATIVE_AI_API_KEY=     # alias accepted
# Chef's Brain — paste EXACTLY on Render (echoaurion-company-os):
ECHO_AI_URL=https://luccca-web.onrender.com/api/company-os/echo-brain
# Bearer matching luccca-web ECHO_BRAIN_SECRET (or COMPANY_OS_INGEST_SECRET)
ECHO_AI_KEY=

# ── Support + Relay (Tier 0 diagnostics, Ask-the-Board, report-a-problem) ─────
# Shared bearer secret deployments use for /api/support/diagnostics and the
# /api/relay/* endpoints (questions, pull, heartbeat, stream, whoami, report).
# DISABLED until this is set.
SUPPORT_INGEST_SECRET=
# Triple handshake Layer 3 (timestamp + nonce). Soft until true — then required.
# RELAY_HANDSHAKE_REQUIRED=true
# RELAY_HANDSHAKE_SKEW_MS=300000

# ── Support voice TTS (Help Desk / future IVR — never guest-facing by default) ─
# SUPPORT_VOICE_PROVIDER=elevenlabs
# SUPPORT_VOICE_ID=
# SUPPORT_VOICE_TTS_ENABLED=false
# SUPPORT_VOICE_API_KEY=            # or ELEVENLABS_API_KEY
# SUPPORT_IVR_WEBHOOK_SECRET=       # optional; falls back to SUPPORT_INGEST_SECRET
# SUPPORT_EMAIL_WEBHOOK_SECRET=     # optional; falls back to SUPPORT_INGEST_SECRET
# SUPPORT_SMS_WEBHOOK_SECRET=       # optional; falls back to SUPPORT_INGEST_SECRET
# SUPPORT_IVR_PUBLIC_URL=           # full webhook URL for Twilio signature validation

# ── Twilio (optional — IVR / SMS status; feature-flagged when unset) ──────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ── Aurion Knowledge Plane (Echo Resonance Network) ───────────────────────────
# Bearer for POST /api/knowledge/ingest. Falls back to SUPPORT_INGEST_SECRET if unset.
# Rejects PII-like keys. See docs/AURION_KNOWLEDGE_PLANE.md
KNOWLEDGE_INGEST_SECRET=

# ── Knights standby / Autonomy dial ───────────────────────────────────────────
# Legacy: off | draft_only | auto_answer_low_risk
# Elite dial (preferred): assist | standby | autopilot — DB toggle on Pilot links overrides.
# Accuracy: TEXT how-to only; never auto-execute WorkRequest. See docs/ELITE_DR_OS.md
KNIGHTS_STANDBY_MODE=off
AUTONOMY_DIAL=assist
STANDBY_MAX_AUTO_PER_HOUR=10
# When true (default), POST /api/relay/questions auto-runs Knights draft + HelpTicket TEXT
# TECH + OTHER always eligible when ON; BUILD + BILLING hard-skip auto-Knights.
AUTO_KNIGHTS_ON_QUESTION=true
# When true, low-risk TEXT TECH/OTHER may auto-send after Knights without timed permit.
# Never BUILD / BILLING / code / core. Prefer timed permit in Help Desk UI when unsure.
HELP_DESK_AUTO_SEND_TECH=false
# Echo AI–captured tickets: auto-approve & send after Knights draft + always echo_repair_ready.
# Default true when unset (testing). Set false for production dual-control (William Approve).
# Alias: HELP_DESK_ECHO_AUTO_APPROVE. Never auto BUILD / payroll disclose / core merge.
ECHO_AUTO_APPROVE=true

# ── Build spend cap (per clientKey / calendar month UTC) ───────────────────────
BUILD_SPEND_CAP_USD=5000

# ── Architect draft PR (optional — plan always stored on WorkRequest) ─────────
# GITHUB_TOKEN already listed above. Optional overrides:
# GITHUB_BUILD_REPO=wmorrison76/EchoAurion-Company-OS
# GITHUB_BUILD_BASE=main

# ── Web Push (SuperAdmin phone app notifications) ─────────────────────────────
# Generate a key pair: npx web-push generate-vapid-keys
# Push send is DORMANT until both keys are present. The client fetches the
# public key from /api/push/subscribe, so no NEXT_PUBLIC_* var is needed.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:william@echoaurion.com

# ── Billable change requests (Ask-the-Board fix/add-on pricing) ───────────────
# Quote = WORK_SENIOR_RATE × hours × WORK_VALUE_MULTIPLIER × tier-multiplier.
WORK_SENIOR_RATE=185                 # senior-engineer billing rate (USD/hr)
WORK_VALUE_MULTIPLIER=2.5            # managed-service value multiplier

# ── Admin User ────────────────────────────────────────────────────────────────
ADMIN_EMAIL=william@echoaurion.com  # Canonical Super Admin / Dr. OS test identity
ADMIN_PASSWORD_HASH=                # bcrypt hash of admin password (bootstrap)
# After the first successful password reset, the live hash is stored in the
# admin_auth DB table and preferred over ADMIN_PASSWORD_HASH. You do NOT need
# to update the Render env var when resetting via Forgot Password.

# ── Transactional email (Forgot Password + fix digest) ────────────────────────
# Without RESEND_API_KEY (or SMTP_*) + EMAIL_FROM, forgot-password returns EMAIL_NOT_CONFIGURED.
# Resend free tier + EMAIL_FROM=onboarding@resend.dev: can ONLY send TO the Resend account
# owner's email — set ADMIN_EMAIL to that same inbox for testing. Verify a domain to send elsewhere.
EMAIL_FROM=                         # onboarding@resend.dev (test) or noreply@your-verified-domain
RESEND_API_KEY=                     # Preferred — https://resend.com/api-keys
# SMTP fallback (used only when RESEND_API_KEY is unset):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false                   # true for port 465

# ── Fix digest email (cron every 4h → POST /api/ops/fix-digest) ──────────────
# Cron service name: echoaurion-company-os-fix-digest
FIX_DIGEST_HOURS=4                  # Window length (hours) for the summary
FIX_DIGEST_TO=                      # Optional; defaults to ADMIN_EMAIL

# ── Echo panel-watch guardrails ───────────────────────────────────────────────
ECHO_PANEL_WATCH=on                 # off | false | 0 = kill switch (no Echo auto-tickets)
ECHO_TICKETS_PER_CLIENT_PER_HOUR=8  # Max Echo→Help Desk tickets per property per hour
ECHO_ONCALL_MINUTES=30              # Unresolved Echo TECH → email William
ECHO_ONCALL_TO=                     # Optional; falls back to FIX_DIGEST_TO / ADMIN_EMAIL
ECHO_ONCALL=on                      # off to disable on-call paging
ECHO_PANEL_REGRESSION_FACTOR=1.5    # Night cleaner p95 vs baseline fail multiplier
# Requires EMAIL_FROM + RESEND_API_KEY (or SMTP_*). If unset, cron logs skip and exits 0.

