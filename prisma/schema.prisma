// prisma/schema.prisma
// EchoAurion Company OS — see CLAUDE.md §9 for the authoritative schema spec.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ── Audit ──────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  actor     String // "william_morrison" | "computer_agent"
  action    String // e.g. "crm.contact.create"
  entityId  String?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([actor])
  @@index([createdAt])
  @@map("audit_log")
}

// ── Admin auth (password reset without touching Render env) ────────────────
// Single-row override: when present, auth prefers passwordHash over
// process.env.ADMIN_PASSWORD_HASH. Email identity remains ADMIN_EMAIL.

model AdminAuth {
  id           String   @id @default("admin")
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_auth")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ── Financial Monitor ──────────────────────────────────────────────────────

model PlaidItem {
  id              String   @id @default(cuid())
  itemId          String   @unique
  accessToken     String
  institutionName String
  accountType     String // "personal_checking" | "business_checking"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  accounts PlaidAccount[]

  @@map("plaid_items")
}

model PlaidAccount {
  id             String   @id @default(cuid())
  plaidAccountId String   @unique
  itemId         String
  item           PlaidItem @relation(fields: [itemId], references: [id])
  name           String
  type           String
  subtype        String?
  mask           String?
  createdAt      DateTime @default(now())

  balanceSnapshots BalanceSnapshot[]
  transactions     Transaction[]

  @@map("plaid_accounts")
}

model BalanceSnapshot {
  id        String       @id @default(cuid())
  accountId String
  account   PlaidAccount @relation(fields: [accountId], references: [id])
  available Float?
  current   Float
  limit     Float?
  snappedAt DateTime     @default(now())

  @@index([accountId, snappedAt])
  @@map("balance_snapshots")
}

model Transaction {
  id                 String       @id @default(cuid())
  accountId          String
  account            PlaidAccount @relation(fields: [accountId], references: [id])
  plaidTransactionId String       @unique
  amount             Float
  date               DateTime
  name               String
  merchantName       String?
  category           String[]
  pending            Boolean      @default(false)
  createdAt          DateTime     @default(now())

  @@index([accountId, date])
  @@map("transactions")
}

model MercurySnapshot {
  id          String   @id @default(cuid())
  accountId   String // Mercury account UUID
  accountName String
  available   Float
  current     Float
  snappedAt   DateTime @default(now())

  @@index([snappedAt])
  @@map("mercury_snapshots")
}

model Bill {
  id        String   @id @default(cuid())
  name      String
  amount    Float
  dueDay    Int // day of month (1-31)
  category  String // "rent" | "subscription" | "software" | "other"
  isActive  Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bills")
}

// ── Dr. OS ─────────────────────────────────────────────────────────────────
// Manual pilot-client record (CLAUDE.md §10.2).

model Pilot {
  id          String   @id @default(cuid())
  name        String
  stage       String // DealStage value, stored as string for the manual record
  health      String // "GREEN" | "AMBER" | "RED"
  lastContact DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("pilots")
}

// ── CRM ────────────────────────────────────────────────────────────────────

model Contact {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String?
  phone     String?
  company   String?
  title     String?
  linkedIn  String?
  tags      String[] // ["investor", "advisor", "integration_partner", "pilot"]
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outreach Outreach[]
  deals    Deal[]

  @@map("contacts")
}

model Outreach {
  id         String         @id @default(cuid())
  contactId  String
  contact    Contact        @relation(fields: [contactId], references: [id])
  channel    String // "email" | "linkedin" | "phone" | "in_person"
  subject    String?
  body       String?
  sentAt     DateTime
  status     OutreachStatus @default(SENT)
  responseAt DateTime?
  actor      String // "william_morrison" | "computer_agent"
  createdAt  DateTime       @default(now())

  @@index([contactId])
  @@map("outreach")
}

enum OutreachStatus {
  SENT
  OPENED
  RESPONDED
  BOUNCED
  NO_REPLY
}

model Deal {
  id                String    @id @default(cuid())
  contactId         String
  contact           Contact   @relation(fields: [contactId], references: [id])
  title             String
  value             Float? // USD
  stage             DealStage @default(IDENTIFIED)
  notes             String?
  expectedCloseDate DateTime?
  closedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([stage])
  @@map("deals")
}

enum DealStage {
  IDENTIFIED
  CONTACTED
  RESPONDED
  MEETING
  ACTIVE
  CLOSED_WON
  CLOSED_LOST
}

// ── Revenue ────────────────────────────────────────────────────────────────

model MRRSnapshot {
  id            String   @id @default(cuid())
  mrr           Float
  customerCount Int
  newMRR        Float    @default(0)
  churnedMRR    Float    @default(0)
  expansionMRR  Float    @default(0)
  snappedAt     DateTime @default(now())

  @@index([snappedAt])
  @@map("mrr_snapshots")
}

// Single-row raise configuration (CLAUDE.md §14.4), upsert pattern.
model RaiseConfig {
  id            String   @id @default(cuid())
  target        Float    @default(500000)
  committed     Float    @default(0)
  conversations Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@map("raise_config")
}

// ── Board Room (board-room-spec.md) ─────────────────────────────────────────
// Multi-AI orchestration. The thread/message model is the structural core;
// the UI is cosmetic on top of it (spec note #2).

model BoardRoomSession {
  id        String           @id @default(cuid())
  problem   String
  sandbox   Boolean          @default(false) // hard write-guard (spec note #5)
  status    BoardRoomStatus  @default(DISPATCHING)
  synthesis String? // Maestro's synthesized action plan
  actor     String // "william_morrison" | "computer_agent"
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  responses KnightResponse[]

  @@index([createdAt])
  @@map("board_room_sessions")
}

enum BoardRoomStatus {
  DISPATCHING
  SYNTHESIZING
  COMPLETE
  FAILED
}

model KnightResponse {
  id        String               @id @default(cuid())
  sessionId String
  session   BoardRoomSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  seat      String // "maestro" | "analyst" | "scout" | "strategist" | "chefs_brain" | "architect"
  model     String
  status    KnightResponseStatus @default(PENDING)
  content   String?
  error     String?
  latencyMs Int?
  createdAt DateTime             @default(now())

  @@index([sessionId])
  @@map("knight_responses")
}

enum KnightResponseStatus {
  PENDING
  RESPONDED
  UNAVAILABLE
  TIMEOUT
  ERROR
}

// ── Board Room — Action Layer (Phase 4, approval-gated) ─────────────────────

model BoardAction {
  id        String            @id @default(cuid())
  sessionId String?
  type      BoardActionType
  status    BoardActionStatus @default(PROPOSED)
  title     String
  summary   String?
  // Typed draft payload (e.g. email to/subject/body, ticket labels, event time).
  payload   Json?
  // Record of what an execute did (or would do) — never auto-sends outward.
  result    Json?
  sandbox   Boolean           @default(false)
  actor     String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([sessionId])
  @@index([status])
  @@map("board_actions")
}

enum BoardActionType {
  TICKET
  EMAIL
  CALENDAR
  NOTE
}

enum BoardActionStatus {
  PROPOSED
  APPROVED
  EXECUTED
  DISMISSED
}

// ── Board Room — Daily Briefing (Phase 4 cron) ──────────────────────────────

model BoardBriefing {
  id        String   @id @default(cuid())
  // Structured snapshot used to render the briefing card.
  snapshot  Json
  headline  String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("board_briefings")
}

// ── Support (Tier 0 — passive diagnostics + sessions) ───────────────────────
// Reaches the product's Electron clients over the network only (no code import
// from the product repo). Tier 0 is view-only: diagnostics in, no screen, no
// remote control. See the support console for the capability ladder.

model SupportClient {
  id                String    @id @default(cuid())
  clientKey         String    @unique // stable install/machine id reported by the Electron app
  label             String // friendly name, e.g. "Miccosukee — Kitchen Line 1"
  property          String? // grouping, e.g. "Miccosukee Resort & Gaming"
  contactId         String? // optional CRM Contact link (no FK — soft reference)
  lastHeartbeatAt   DateTime? // canonical pilot heartbeat (diagnostics or /api/relay/heartbeat)
  lastHealth        String? // GREEN | AMBER | RED | UNKNOWN from last heartbeat
  lastStreamAt      DateTime? // last successful SSE connect / event delivery
  /// Optional per-install secret: bcrypt/sha256 hash. When set, relay Bearer must match
  /// this client instead of (or in addition to) shared SUPPORT_INGEST_SECRET.
  /// Prefer hash verify — never store plaintext. Shared secret remains fallback until all
  /// installs migrate. See docs/CUSTOMER_AI_COST.md / OPEN_OPS_CHECKLIST.md.
  ingestSecretHash  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  snapshots DiagnosticSnapshot[]
  sessions  SupportSession[]
  costSnapshots CustomerCostSnapshot[]

  @@map("support_clients")
}

model DiagnosticSnapshot {
  id         String        @id @default(cuid())
  clientId   String
  client     SupportClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appVersion String?
  platform   String? // "darwin" | "win32" | "linux"
  online     Boolean       @default(true)
  queueDepth Int           @default(0) // offline-queue backlog
  lastSyncAt DateTime?
  errorCount Int           @default(0)
  health     String        @default("UNKNOWN") // "GREEN" | "AMBER" | "RED" | "UNKNOWN"
  details    Json? // bounded raw bundle for drill-down
  createdAt  DateTime      @default(now())

  @@index([clientId, createdAt])
  @@map("diagnostic_snapshots")
}

// Operator-captured anonymized health (conflict detection / Knights sandbox).
// Payload must never include guest PII — see docs/SECURITY_RELAY.md.
model SystemSnapshot {
  id            String   @id @default(cuid())
  source        String   @default("operator") // operator | fleet | cron
  health        String   @default("UNKNOWN") // GREEN | AMBER | RED | UNKNOWN
  payload       Json
  sentToKnights Boolean  @default(false)
  actor         String // william_morrison | computer_agent
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@map("system_snapshots")
}

model SupportSession {
  id        String               @id @default(cuid())
  clientId  String?
  client    SupportClient?       @relation(fields: [clientId], references: [id])
  contactId String?
  topic     String
  status    SupportSessionStatus @default(OPEN)
  notes     String?
  actor     String // "william_morrison" | "computer_agent"
  openedAt  DateTime             @default(now())
  closedAt  DateTime?

  @@index([status])
  @@map("support_sessions")
}

enum SupportSessionStatus {
  OPEN
  WAITING_ON_CUSTOMER
  RESOLVED
}

// ── Ask-the-Board relay ─────────────────────────────────────────────────────
// A deployment submits a question keyed by an opaque clientKey (the product
// stays hidden). An AI seat drafts an answer; William approves on his phone;
// the deployment pulls the approved answer/directive back down. No remote access.

model CustomerQuestion {
  id              String         @id @default(cuid())
  clientId        String? // SupportClient soft link (resolved by clientKey)
  clientKey       String // opaque deployment id — never reveals the product name
  question        String
  context         Json? // optional structured context from the deployment
  /// Intake taxonomy from Help Desk gate step (TECH | BILLING | BUILD | OTHER).
  intakeGate      IntakeGate?
  status          QuestionStatus @default(NEW)
  draftSeat       String? // which AI seat produced the draft
  draftAnswer     String?
  answer          String? // William's approved final answer
  directive       Json? // optional structured change for the deployment to apply
  delivered       Boolean        @default(false) // pulled back by the deployment
  standbyApproved Boolean        @default(false) // true when Knights standby auto-approved
  actor           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  answeredAt      DateTime?

  attachments HelpAttachment[]

  @@index([status])
  @@index([clientKey, delivered])
  @@index([standbyApproved, answeredAt])
  @@map("customer_questions")
}

/// Pilot Help Desk screenshots (max 2 per question). DB bytes — no S3 runtime yet.
/// Retention: ~90 days (see docs/HELP_DESK.md). Never log `data` bytes.
model HelpAttachment {
  id                 String            @id @default(cuid())
  customerQuestionId String?
  customerQuestion   CustomerQuestion? @relation(fields: [customerQuestionId], references: [id], onDelete: Cascade)
  ticketId           String?
  ticket             HelpTicket?       @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  mimeType           String // image/png | image/jpeg | image/webp
  fileName           String?
  altText            String?
  byteSize           Int
  widthPx            Int?
  heightPx           Int?
  /// EXIF-stripped image bytes. Prefer Help Desk screenshots over Cursor Bugbot Autofix for cost.
  data               Bytes
  createdAt          DateTime          @default(now())

  @@index([customerQuestionId])
  @@index([ticketId])
  @@index([createdAt])
  @@map("help_attachments")
}

enum QuestionStatus {
  NEW // received, no draft yet
  DRAFTED // AI draft ready, awaiting William
  ANSWERED // William approved — deliverable
  DISMISSED
}

// ── Alerts (phone-bound notifications) ──────────────────────────────────────

model Alert {
  id        String   @id @default(cuid())
  kind      String // "client_health" | "question" | "report" | "system"
  severity  String // "INFO" | "WARN" | "CRITICAL"
  title     String
  body      String?
  entityRef String? // related id (clientId, questionId, …)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
  @@map("alerts")
}

// ── Web Push subscriptions (SuperAdmin phone app) ───────────────────────────

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@map("push_subscriptions")
}

// ── Billable change requests (Ask-the-Board "build me a fix/add-on") ─────────
// A customer requests work from inside support (never sees the product). The
// Board Room drafts it in sandbox; it's quoted by complexity tier; the
// property's designated billing contact authorizes the spend (two-key with
// William's execute approval); every executed change keeps a rollback path.

model WorkRequest {
  id        String     @id @default(cuid())
  clientId  String?
  clientKey String // opaque deployment id — product stays hidden
  kind      WorkKind   @default(FIX)
  title     String
  detail    String
  context   Json?
  // requester gating (who at the property asked)
  requesterName String?
  requesterRole String?
  // pricing (frozen at quote time)
  tier          String? // ComplexityTier T1..T5
  humanHours    Float?
  quoteTotal    Float?
  quoteSnapshot Json?
  // Board Room draft (sandbox-first)
  draftSeat String?
  draftPlan String?
  // approvals (two-key) + rollback
  approvedByCustomer Boolean @default(false)
  customerApprover   String? // billing-contact name who authorized spend
  approvedByAdmin    Boolean @default(false)
  rollbackRef        String? // revert SHA / snapshot — REQUIRED before EXECUTED
  delivered          Boolean @default(false)
  status    WorkStatus @default(RECEIVED)
  actor     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  quotedAt     DateTime?
  authorizedAt DateTime?
  executedAt   DateTime?
  rolledBackAt DateTime?

  agreement WorkAgreement?

  @@index([status])
  @@index([clientKey, delivered])
  @@map("work_requests")
}

// Paid-via-profile agreement — signer is the logged-in product profile
// (ADMIN / DIRECTOR / EXEC only). Authorize is blocked without this row.
// See docs/PAID_VIA_PROFILE.md.
model WorkAgreement {
  id            String   @id @default(cuid())
  workRequestId String   @unique
  workRequest   WorkRequest @relation(fields: [workRequestId], references: [id], onDelete: Cascade)
  signerName    String
  signerEmail   String?
  signerRole    String // ADMIN | DIRECTOR | EXEC (normalized)
  typedSignature String // must match signerName (case-insensitive trim)
  agreedAt      DateTime @default(now())
  quoteTotal    Float? // frozen amount acknowledged at agree time
  source        String   @default("profile") // profile | lab | relay
  /// Stripe Invoice id when created/linked after authorize (optional until keys set).
  stripeInvoiceId String?
  /// Hosted invoice URL for billing contact (no card data stored here).
  stripeInvoiceUrl String?
  invoiceStatus    String? // draft | open | paid | void | uncollectible | linked
  createdAt     DateTime @default(now())

  @@index([signerRole])
  @@index([stripeInvoiceId])
  @@map("work_agreements")
}

enum WorkKind {
  FIX
  ADDON
}

enum WorkStatus {
  RECEIVED // submitted, needs triage
  QUOTED // tier + price set, awaiting customer authorization
  AUTHORIZED // billing contact approved the quote
  IN_PROGRESS // admin approved + sandbox work underway
  EXECUTED // applied, rollback recorded
  ROLLED_BACK
  DECLINED
}

// Designated billing contact(s) per property — the only profiles allowed to
// authorize paid work. The token is the credential the deployment presents.
model BillingContact {
  id        String   @id @default(cuid())
  clientKey String // property/deployment scope
  name      String
  email     String?
  token     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([clientKey])
  @@map("billing_contacts")
}

// ── Aurion Knowledge Plane (Echo Resonance Network) ─────────────────────────
// Anonymized telemetry + assembled insights. No guest PII. See
// docs/AURION_KNOWLEDGE_PLANE.md.

model KnowledgeSignal {
  id                String   @id @default(cuid())
  clientKey         String // opaque property/edge id — never guest identity
  schemaVersion     String   @default("1")
  signalType        String // ops_pattern | menu_hotspot | buying_pattern | system_health | knowledge_meta
  territoryCode     String?
  aggregationLevel  String   @default("property") // property | territory | network
  windowStart       DateTime?
  windowEnd         DateTime?
  payload           Json // allowlisted fields only (PII keys rejected at ingest)
  sampleSize        Int?
  confidence        Float?
  createdAt         DateTime @default(now())

  @@index([signalType, createdAt])
  @@index([clientKey, createdAt])
  @@index([territoryCode, createdAt])
  @@map("knowledge_signals")
}

model KnowledgeInsight {
  id               String   @id @default(cuid())
  title            String
  summary          String
  insightClass     String // territory_food_trend | product_hotspot | buying_pattern | ops_pattern | other
  aggregationLevel String   @default("territory") // property | territory | network
  territoryCode    String?
  confidence       Float?
  sampleSize       Int?
  sourceSeat       String? // e.g. maestro | perplexity
  payload          Json?
  published        Boolean  @default(false)
  actor            String // william_morrison | computer_agent
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([insightClass, createdAt])
  @@index([published, createdAt])
  @@map("knowledge_insights")
}

model VendorAccessRequest {
  id           String              @id @default(cuid())
  vendorName   String
  contactEmail String?
  useCase      String
  scopeNotes   String?
  status       VendorAccessStatus  @default(PENDING)
  reviewedBy   String?
  reviewedAt   DateTime?
  actor        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([status, createdAt])
  @@map("vendor_access_requests")
}

enum VendorAccessStatus {
  PENDING
  APPROVED
  DENIED
  REVOKED
}

// ── Help Desk (Knights of the Round Table operator workspace) ───────────────
// Live ticket workspace for text, voice dictation, Ask Knights, and custom
// builds. Distinct from Board Room (strategy counsel) and Support (client
// health + approve gate). See docs/HELP_DESK.md.

model HelpTicket {
  id                 String            @id @default(cuid())
  channel            HelpTicketChannel @default(TEXT)
  status             HelpTicketStatus  @default(OPEN)
  priority           String            @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  subject            String
  /// Gate taxonomy (in-app first; phone IVR later). Maps to free vs paid path.
  intakeGate         IntakeGate?
  /// How the request arrived (extensible). Distinct from HelpTicketChannel (TEXT/VOICE/…).
  intakeChannel      IntakeChannel     @default(IN_APP)
  clientKey          String?
  clientId           String?
  requesterName      String?
  workRequestId      String?
  customerQuestionId String?
  boardSessionId     String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  resolvedAt         DateTime?

  // ── SLA clocks (enforced targets — shape+label in UI) ─────────────────────
  /// First admin/knight reply clock start is createdAt; stamped on first non-customer msg.
  firstResponseAt    DateTime?
  /// Due timestamps computed at create / gate change (see src/lib/support-sla.ts).
  firstResponseDueAt DateTime?
  resolveDueAt       DateTime?
  slaBreachedAt      DateTime?
  /// Escalation note when breach fires (operator Alert + timeline).
  slaEscalatedAt     DateTime?

  // ── Post-resolve CSAT (1–5) ───────────────────────────────────────────────
  csatScore          Int? // 1–5
  csatComment        String? // optional short note — scrub PII in analytics
  closeReason        String? // resolved_howto | resolved_config | resolved_fix | reply_sent_code_pending | duplicate | spam | other

  // ── Error capture / blast-radius (ZARO → Help Desk) ──────────────────────
  // See docs/ERROR_CAPTURE_AND_SCOPE.md. Fingerprint dedupes within 1h.
  errorScope         ErrorBlastScope?
  errorCategory      ErrorCategory?
  productLine        String? // echoaurion | company-os | aurion-index | …
  fingerprint        String?
  occurrenceCount    Int              @default(1)
  affectedClientKeys String[]         @default([])
  lastOccurredAt     DateTime?
  notifyWhenFixed    Boolean          @default(true)
  sessionHint        String? // opaque hash — never PII
  errorClass         String?
  moduleHint         String?
  /// When Architect/Knights propose core-path changes → NEEDS_HUMAN_CORE_REVIEW
  needsHumanCoreReview Boolean        @default(false)

  // ── Continuous improvement flywheel ───────────────────────────────────────
  /// COHORT metadata (browser / OS / appVersion) — never PII.
  cohortBrowser    String?
  cohortOs         String?
  cohortAppVersion String?
  /// GLOBAL resolve stages: null | canary | fleet
  rolloutStage     String?
  /// Optional canary clientKeys before fleet notify (GLOBAL).
  canaryClientKeys String[]         @default([])
  /// computer_agent + Knights actively drafting / PR-planning
  agentWorking     Boolean          @default(false)

  // ── Fix truth-telling (docs/TICKET_VS_CODE_FIX_AUDIT.md P1/P2) ────────────
  /// True only when a merged commit for this ticket's fix actually deployed.
  productFixDeployed Boolean        @default(false)
  /// Short SHA of the deployed fix commit — the "code really shipped" receipt.
  fixedInSha         String?

  messages    HelpMessage[]
  voiceNotes  HelpVoiceNote[]
  timeline    HelpTimelineEvent[]
  attachments HelpAttachment[]

  @@index([status, updatedAt])
  @@index([channel, status])
  @@index([intakeGate, status])
  @@index([intakeChannel, status])
  @@index([clientKey])
  @@index([customerQuestionId])
  @@index([workRequestId])
  @@index([fingerprint, status])
  @@index([fingerprint, clientKey, status])
  @@index([errorScope, status])
  @@index([errorCategory, productLine])
  // SLA breach scan (OR across the three due/breach clocks) — bitmap-or friendly.
  @@index([slaBreachedAt])
  @@index([firstResponseDueAt])
  @@index([resolveDueAt])
  @@map("help_tickets")
}

/// In-app / IVR intake taxonomy — free (TECH/BILLING/OTHER) vs paid (BUILD).
enum IntakeGate {
  TECH
  BILLING
  BUILD
  OTHER
}

/// Arrival channel for support (extensible). Not the same as HelpTicketChannel.
enum IntakeChannel {
  IN_APP
  VOICE
  PHONE_IVR
  EMAIL
  SMS
  /// Auto-filed from product Echo AI failure / timeout / cannot-complete.
  ECHO
}

/// Blast radius for auto-captured runtime errors.
enum ErrorBlastScope {
  USER
  ACCOUNT
  COHORT
  GLOBAL
}

/// Taxonomy for fleet-wide learning (aggregated, no PII).
enum ErrorCategory {
  UI
  API
  AUTH
  DATA
  INTEGRATION
  INFRA
  UNKNOWN
}

/// Aggregated error patterns across sold systems — trend analysis only, no PII.
model ErrorPattern {
  id              String          @id @default(cuid())
  fingerprint     String
  errorCategory   ErrorCategory
  errorScope      ErrorBlastScope
  productLine     String // echoaurion | company-os | …
  moduleHint      String?
  errorClass      String?
  sampleMessage   String // redacted / truncated
  hitCount        Int             @default(1)
  distinctClients Int             @default(1)
  firstSeenAt     DateTime        @default(now())
  lastSeenAt      DateTime        @default(now())
  lastTicketId    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([fingerprint, productLine])
  @@index([errorCategory, productLine, lastSeenAt])
  @@index([errorScope, lastSeenAt])
  @@index([hitCount])
  @@map("error_patterns")
}

enum HelpTicketChannel {
  TEXT
  VOICE
  FEATURE
  SYSTEM
}

enum HelpTicketStatus {
  OPEN
  WAITING
  WITH_KNIGHTS
  AWAITING_APPROVAL
  RESOLVED
  CLOSED
}

model HelpMessage {
  id        String          @id @default(cuid())
  ticketId  String
  ticket    HelpTicket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  role      HelpMessageRole
  body      String
  seat      String? // knight seat when role = KNIGHT
  createdAt DateTime        @default(now())

  @@index([ticketId, createdAt])
  @@map("help_messages")
}

enum HelpMessageRole {
  CUSTOMER
  ADMIN
  KNIGHT
  SYSTEM
}

model HelpVoiceNote {
  id          String              @id @default(cuid())
  ticketId    String
  ticket      HelpTicket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  transcript  String
  durationSec Int?
  source      HelpVoiceNoteSource @default(PASTE)
  createdAt   DateTime            @default(now())

  @@index([ticketId, createdAt])
  @@map("help_voice_notes")
}

enum HelpVoiceNoteSource {
  UPLOAD
  DICTATION
  PASTE
}

// ── Help File / Knowledge Base (searchable macros Knights + operators cite) ─
// See docs/HELP_DESK.md. panelId optionally opens a pilot panel via directive.

model HelpArticle {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  body      String
  tags      String[] // e.g. ["login", "beo", "fleet", "company-os"]
  panelId   String? // optional Echo-like panel to open when sent (see help-panels.ts)
  /// When true, visible on public /help-center (property-facing lite).
  public    Boolean  @default(false)
  /// Prefer as Help Desk macro chip (operator insert library).
  isMacro   Boolean  @default(false)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([updatedAt])
  @@index([public, updatedAt])
  @@index([isMacro, updatedAt])
  @@map("help_articles")
}

// ── Pilot Connection Hub (relay outbox + Knights standby) ───────────────────
// Company OS pushes events to pilots via SSE; undelivered rows survive restarts.
// Pull endpoints remain the fallback. See docs/PILOT_CONNECTION.md.

model RelayOutbox {
  id          String    @id @default(cuid())
  clientKey   String
  type        String // answer_ready | work_status | directive | show_message | open_panel | navigate | maintenance_notice | feature_available | update_available | soft_reload | client_update | ping
  payload     Json
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?

  @@index([clientKey, deliveredAt, createdAt])
  @@index([createdAt])
  @@map("relay_outbox")
}

/// Single-row operator settings for Knights standby when William is unavailable.
/// mode also accepts elite autonomy dial: assist | standby | autopilot
/// (mapped in src/lib/autonomy.ts). Legacy: off | draft_only | auto_answer_low_risk
/// Timed unlock: helpDeskAutoSendEnabled + helpDeskAutoSendUntil permits low-risk
/// TEXT TECH/OTHER auto-send without permanently flipping standby mode.
model StandbySettings {
  id                      String    @id @default("default")
  mode                    String    @default("off") // off | draft_only | auto_answer_low_risk | assist | standby | autopilot
  maxAutoPerHour          Int       @default(10)
  /// Temporary permit: when true and now < helpDeskAutoSendUntil, low-risk TEXT may auto-send.
  helpDeskAutoSendEnabled Boolean   @default(false)
  helpDeskAutoSendUntil   DateTime?
  updatedAt               DateTime  @updatedAt
  updatedBy               String? // william_morrison | computer_agent

  @@map("standby_settings")
}

// ── Elite Help Desk (constitution / eval / break-glass / timeline) ───────────
// See docs/ELITE_DR_OS.md, docs/HELP_EVAL.md, docs/CONSTITUTION.md

model HelpTimelineEvent {
  id                String   @id @default(cuid())
  ticketId          String
  ticket            HelpTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  kind              String // received | drafting | quoted | agreement_signed | shipping | done
  label             String
  detail            String?
  actor             String   @default("william_morrison")
  visibleToCustomer Boolean  @default(true)
  createdAt         DateTime @default(now())

  @@index([ticketId, createdAt])
  @@map("help_timeline_events")
}

model HelpEvalCase {
  id                    String   @id
  prompt                String
  expectedChannel       String // TEXT | VOICE | FEATURE | SYSTEM
  mustInclude           String[]
  mustNotInclude        String[]
  expectedRecommendation String?
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())

  @@map("help_eval_cases")
}

model HelpEvalRun {
  id         String   @id @default(cuid())
  score      Float
  total      Int
  passed     Int
  failed     Int
  withDrafts Boolean  @default(false)
  results    Json
  actor      String   @default("william_morrison")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@map("help_eval_runs")
}

/// Scaffold only — NOT TeamViewer / RDP. See docs/ELITE_DR_OS.md
model BreakGlassSession {
  id          String   @id @default(cuid())
  clientKey   String
  reason      String
  requestedBy String
  approvedBy  String?
  status      String   @default("REQUESTED") // REQUESTED | APPROVED | EXPIRED | REVOKED | ENDED
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientKey, status])
  @@index([expiresAt])
  @@map("break_glass_sessions")
}

// ── Maintenance / major-update notices (pilot blast) ─────────────────────────
// Scheduled or immediate notices pushed via RelayOutbox (maintenance_notice +
// show_message). See /maintenance UI and POST /api/maintenance/dispatch.

model MaintenanceNotice {
  id           String    @id @default(cuid())
  title        String
  body         String
  severity     String    @default("INFO") // INFO | WARN | CRITICAL
  status       String    @default("DRAFT") // DRAFT | SCHEDULED | SENT | CANCELLED
  scheduledFor DateTime?
  sentAt       DateTime?
  windowStart  DateTime? // optional maintenance window start (client display)
  windowEnd    DateTime? // optional maintenance window end
  targetScope  String    @default("ALL") // ALL | CLIENT_KEY | PROPERTY | CANARY
  targetValue  String? // clientKey or property name when scoped
  /// Optional staged rollout: notify these keys first (canary), then ALL.
  canaryClientKeys String[] @default([])
  createdBy    String    @default("william_morrison")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, scheduledFor])
  @@index([createdAt])
  @@map("maintenance_notices")
}

// ── Knights flywheel — learned runbooks + post-resolve eval ─────────────────
// See docs/KNIGHTS_FLYWHEEL.md. Promotion requires confirmedBy william_morrison
// OR evalScore >= threshold. Core-path content is always denied.

model KnightRunbook {
  id               String         @id @default(cuid())
  fingerprint      String
  productLine      String
  errorCategory    ErrorCategory?
  title            String
  resolutionSteps  String
  /// Always true for new upserts — learning must never auto-write core harm.
  denyIfCore       Boolean        @default(true)
  status           String         @default("DRAFT") // DRAFT | PROMOTED | REJECTED
  confirmedBy      String? // william_morrison required for PROMOTED (unless eval pass)
  evalScore        Float?
  sourceTicketId   String?
  hitCount         Int            @default(1)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([fingerprint, productLine])
  @@index([status, hitCount])
  @@index([errorCategory, productLine])
  @@map("knight_runbooks")
}

/// Post-resolve score: did Knight draft match the final fix?
model KnightEval {
  id           String   @id @default(cuid())
  ticketId     String
  fingerprint  String?
  productLine  String?
  draftText    String // truncated
  finalFixText String // truncated
  score        Float // 0..1 token overlap
  matched      Boolean  @default(false)
  actor        String   @default("computer_agent")
  createdAt    DateTime @default(now())

  @@index([ticketId])
  @@index([createdAt])
  @@index([matched, score])
  @@map("knight_evals")
}

// ── Scale: async ingest job queue (5k-tenant backpressure) ───────────────────
// See docs/SCALE_AND_THROTTLE.md. Expensive work (Knights, notify fan-out,
// learning embed) is drained by POST /api/ops/drain-queue (cron).

model IngestJob {
  id        String    @id @default(cuid())
  kind      String // agent_loop | notify_fanout | knowledge_embed | echo_learn_*
  payload   Json
  dedupeKey String?
  status    String    @default("PENDING") // PENDING | RUNNING | DONE | FAILED
  attempts  Int       @default(0)
  runAfter  DateTime  @default(now())
  lockedAt  DateTime?
  lastError String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, runAfter])
  @@index([kind, status])
  @@index([dedupeKey, status])
  @@map("ingest_jobs")
}

// ── Request nonce / replay cache (handshake Layer 3) ────────────────────────
// See docs/DATA_ISOLATION_AND_COMPLIANCE.md · src/lib/request-handshake.ts

model RequestNonce {
  id         String   @id @default(cuid())
  route      String
  nonce      String
  clientKey  String?
  deliveryId String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@unique([route, nonce])
  @@index([expiresAt])
  @@index([deliveryId])
  @@index([clientKey, createdAt])
  @@map("request_nonces")
}

// ── Real AI token metering (per provider/model/tenant) ───────────────────────
// Captured from provider `usage` responses at the connector layer — replaces
// the flat $0.04/message heuristic as the source of truth. No PII, no prompt
// content — counts and cost only. See docs/CUSTOMER_AI_COST.md.

model AiUsageEvent {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  /// Tenant when attributable; null = owner/internal (Board Room, ops).
  clientKey        String?
  provider         String // openai | anthropic | google | perplexity | echo
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  /// True when the provider returned no usage object (char-count estimate).
  estimated        Boolean  @default(false)
  costUsd          Float    @default(0)
  /// knights | standby | board_room | support_relay | voice | …
  feature          String?

  @@index([createdAt])
  @@index([clientKey, createdAt])
  @@index([provider, model, createdAt])
  @@map("ai_usage_events")
}

// ── Per-customer AI / seat cost snapshots (Fleet enterprise) ─────────────────
// Aggregates only — no guest PII. See docs/CUSTOMER_AI_COST.md.

model CustomerCostSnapshot {
  id              String   @id @default(cuid())
  clientKey       String
  clientId        String?
  client          SupportClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  periodStart     DateTime
  periodEnd       DateTime
  /// Estimated USD for Knights/LLM calls this period (heuristic until token metering).
  estimatedUsd    Float    @default(0)
  tokenEstimate   Int      @default(0)
  callCount       Int      @default(0)
  knightSeatHits  Json? // { maestro: n, analyst: n, … }
  workSpendUsd    Float    @default(0) // authorized WorkRequest quotes
  productLine     String?
  source          String   @default("aggregate") // aggregate | manual | cron
  createdAt       DateTime @default(now())

  @@index([clientKey, periodStart])
  @@index([periodStart, periodEnd])
  @@map("customer_cost_snapshots")
}

// ── Echo Learning Plane (PII-safe chunks; embeddings optional) ───────────────
// See docs/ECHO_LEARNING_PLANE.md. No guest/staff PII. GLOBAL/COHORT teachable
// across Echo instances; ACCOUNT never shared fleet-wide.
// Retrieve remains GLOBAL/COHORT only — pgvector embeddings TODO (embedding Json?).

model EchoKnowledgeChunk {
  id              String   @id @default(cuid())
  section         String // ops | hospitality | runbook | help | error_pattern | procedure | domain
  domain          String?
  sourceType      String // knight_runbook | error_pattern | help_article | pdf | manual
  sourceRef       String?
  contentRedacted String
  metadata        Json?
  /// Reserved for Neon pgvector — null until embeddings enabled (TODO).
  embedding       Json?
  productLine     String?
  /// null when shareScope is GLOBAL or COHORT (fleet-shareable).
  clientKey       String?
  shareScope      String   @default("GLOBAL") // GLOBAL | COHORT | ACCOUNT
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([section, createdAt])
  @@index([sourceType, sourceRef])
  @@index([productLine, shareScope])
  @@index([clientKey, createdAt])
  @@index([shareScope, updatedAt])
  @@map("echo_knowledge_chunks")
}
